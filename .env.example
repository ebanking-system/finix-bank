# ==============================================================================
# Finix Bank - Root Environment Configuration Template (.env.example)
# Copy this file to .env in the root directory: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# AI Assistant (FinixBot) - LLM Configuration
# ------------------------------------------------------------------------------
# Free tier API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# Notification Service - SMTP Email Configuration
# ------------------------------------------------------------------------------
# For Gmail:
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Use your full Gmail address as SMTP_USERNAME and the 16-char App Password as SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_ADDRESS=your_email@gmail.com
SMTP_FROM_NAME="Finix Bank"
