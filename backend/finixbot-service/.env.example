# Groq API Key (Free tier key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Name
GROQ_MODEL_NAME=llama-3.1-8b-instant

# HuggingFace Local Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Local ChromaDB Path
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=finix_faq

# Core Banking Service Gateway URL
BANKING_SERVICE_URL=http://localhost:9090

# RAG Threshold Tuning
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
SIMILARITY_THRESHOLD=0.35
